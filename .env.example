# ============================================================
# AI Bot Live Quiz Arena — Environment Configuration Template
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env with real secrets to version control!
# ============================================================

# Application Server
APP_ENV=development
HOST=127.0.0.1
PORT=8080
CORS_ORIGINS=*

# Arena Authentication (used by POST /api/auth/login)
APP_USERNAME=your_arena_username
APP_PASSWORD=your_arena_password

# JWT Configuration (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_a_64_char_random_hex_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Phase 1: ROV Academy Scraper (Playwright)
ROV_ACADEMY_URL=https://academy.rov.in.th
ROV_LOGIN_URL=https://100055.connect.garena.com/oauth/login?response_type=code&client_id=100055&redirect_uri=https%3A%2F%2Facademy.rov.in.th%2Fauth%2Fcallback%2F&locale=th-TH&platform=1
ROV_USERNAME=your_rov_username
ROV_PASSWORD=your_rov_password
PLAYWRIGHT_HEADLESS=false

# Supabase Database Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
SUPABASE_TABLE=quiz_questions

# Sentry Error Monitoring (optional locally, recommended in production)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# AI Bot Thinking Delay Range (seconds)
BOT_MIN_THINK_SECONDS=2.0
BOT_MAX_THINK_SECONDS=4.0

# External Connection Retry Policy
RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT_SECONDS=1.0
RETRY_MAX_WAIT_SECONDS=4.0
